# Firebase — safe to prefix NEXT_PUBLIC_ (public config values)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LOCAL_DEV_MODE=true
LOCAL_DEV_MODE=true

# Firebase Admin (server-side only)
FIREBASE_SERVICE_ACCOUNT_JSON=

# AI APIs — server-side only, never NEXT_PUBLIC_
GROQ_API_KEY=
GEMINI_API_KEY=

# Railway yt-dlp service
RAILWAY_DOWNLOADER_URL=
RAILWAY_DOWNLOADER_SECRET=
